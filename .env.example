# Base das rotas REST (padrão: /api, interceptado pelo MSW)
VITE_API_URL=/api
# Origem do servidor Socket.IO (padrão: mesma origem da aplicação)
VITE_SOCKET_URL=
# Ativa os mocks MSW (REST + Socket.IO). Use "false" para apontar para um backend real.
VITE_ENABLE_MOCKS=true
# Timeout das requisições REST em ms
VITE_HTTP_TIMEOUT=10000
